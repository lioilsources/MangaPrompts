{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Juggernaut XL Lightning Checkpoint" },
    "inputs": { "ckpt_name": "Juggernaut-XL-Lightning_4Steps.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt" },
    "inputs": {
      "text": "__PROMPT__",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt" },
    "inputs": {
      "text": "blurry, low quality, worst quality, jpeg artifacts, deformed, disfigured, bad anatomy, extra limbs, watermark, signature, text",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty latent (batch)" },
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (Lightning: few steps, low CFG)" },
    "inputs": {
      "seed": 0,
      "steps": 5,
      "cfg": 2.0,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "filename_prefix": "ol1n_juggernaut",
      "images": ["6", 0]
    }
  }
}
