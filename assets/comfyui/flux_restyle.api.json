{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "FLUX dev (PuLID and InstantX are trained on dev)"
    },
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": {
      "title": "T5 + CLIP-L"
    },
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "FLUX VAE"
    },
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference photo"
    },
    "inputs": {
      "image": "__IMAGE__",
      "upload": "image"
    }
  },
  "5": {
    "class_type": "ImageResizeKJv2",
    "_meta": {
      "title": "Fit reference to latent"
    },
    "inputs": {
      "image": [
        "4",
        0
      ],
      "width": 832,
      "height": 1216,
      "upscale_method": "lanczos",
      "keep_proportion": "pad",
      "pad_color": "0, 0, 0",
      "crop_position": "center",
      "divisible_by": 16
    }
  },
  "6": {
    "class_type": "DepthAnythingV2Preprocessor",
    "_meta": {
      "title": "Depth map from reference"
    },
    "inputs": {
      "image": [
        "5",
        0
      ],
      "ckpt_name": "depth_anything_v2_vitl.pth",
      "resolution": 768
    }
  },
  "7": {
    "class_type": "ControlNetLoader",
    "_meta": {
      "title": "FLUX depth ControlNet (InstantX)"
    },
    "inputs": {
      "control_net_name": "flux-depth-controlnet-v3.safetensors"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "__PROMPT__"
    }
  },
  "9": {
    "class_type": "FluxGuidance",
    "_meta": {
      "title": "FLUX guidance"
    },
    "inputs": {
      "conditioning": [
        "8",
        0
      ],
      "guidance": 3.5
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (unused at cfg 1)"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": ""
    }
  },
  "11": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {
      "title": "Keep the pose (depth)"
    },
    "inputs": {
      "positive": [
        "9",
        0
      ],
      "negative": [
        "10",
        0
      ],
      "control_net": [
        "7",
        0
      ],
      "image": [
        "6",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "strength": 0.55,
      "start_percent": 0.0,
      "end_percent": 0.9
    }
  },
  "12": {
    "class_type": "PulidFluxModelLoader",
    "_meta": {
      "title": "PuLID FLUX"
    },
    "inputs": {
      "pulid_file": "pulid_flux_v0.9.1.safetensors"
    }
  },
  "13": {
    "class_type": "PulidFluxEvaClipLoader",
    "_meta": {
      "title": "EVA-CLIP"
    },
    "inputs": {}
  },
  "14": {
    "class_type": "PulidFluxInsightFaceLoader",
    "_meta": {
      "title": "InsightFace (antelopev2)"
    },
    "inputs": {
      "provider": "CPU"
    }
  },
  "15": {
    "class_type": "ApplyPulidFlux",
    "_meta": {
      "title": "Keep the face (PuLID)"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "pulid_flux": [
        "12",
        0
      ],
      "eva_clip": [
        "13",
        0
      ],
      "face_analysis": [
        "14",
        0
      ],
      "image": [
        "5",
        0
      ],
      "weight": 0.9,
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "16": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Latent (bucket)"
    },
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "17": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    },
    "inputs": {
      "model": [
        "15",
        0
      ],
      "positive": [
        "11",
        0
      ],
      "negative": [
        "11",
        1
      ],
      "latent_image": [
        "16",
        0
      ],
      "seed": 0,
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "17",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "19": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    },
    "inputs": {
      "images": [
        "18",
        0
      ],
      "filename_prefix": "tsumiki_restyle_flux"
    }
  }
}
