{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "SDXL checkpoint"
    },
    "inputs": {
      "ckpt_name": "__CKPT__"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Hairstyle (positive)"
    },
    "inputs": {
      "text": "__PROMPT__",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Portrait"
    },
    "inputs": {
      "image": "__IMAGE__",
      "upload": "image"
    }
  },
  "40": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Hair mask (white = repaint)"
    },
    "inputs": {
      "image": "__MASK__",
      "upload": "image"
    }
  },
  "41": {
    "class_type": "ImageToMask",
    "_meta": {
      "title": "Mask PNG to MASK"
    },
    "inputs": {
      "image": [
        "40",
        0
      ],
      "channel": "red"
    }
  },
  "90": {
    "class_type": "InpaintCropImproved",
    "_meta": {
      "title": "Crop around the mask"
    },
    "inputs": {
      "image": [
        "4",
        0
      ],
      "mask": [
        "41",
        0
      ],
      "downscale_algorithm": "bilinear",
      "upscale_algorithm": "bicubic",
      "preresize": false,
      "preresize_mode": "ensure minimum resolution",
      "preresize_min_width": 1024,
      "preresize_min_height": 1024,
      "preresize_max_width": 16384,
      "preresize_max_height": 16384,
      "mask_fill_holes": false,
      "mask_expand_pixels": 0,
      "mask_invert": false,
      "mask_blend_pixels": 32,
      "mask_hipass_filter": 0.1,
      "extend_for_outpainting": false,
      "extend_up_factor": 1.0,
      "extend_down_factor": 1.0,
      "extend_left_factor": 1.0,
      "extend_right_factor": 1.0,
      "context_from_mask_extend_factor": 1.5,
      "output_resize_to_target_size": true,
      "output_target_width": 1024,
      "output_target_height": 1024,
      "output_padding": "32",
      "device_mode": "gpu (much faster)"
    }
  },
  "50": {
    "class_type": "INPAINT_LoadFooocusInpaint",
    "_meta": {
      "title": "Fooocus inpaint patch"
    },
    "inputs": {
      "head": "fooocus_inpaint_head.pth",
      "patch": "inpaint_v26.fooocus.patch"
    }
  },
  "5": {
    "class_type": "VAEEncodeForInpaint",
    "_meta": {
      "title": "VAE encode (inpaint)"
    },
    "inputs": {
      "pixels": [
        "90",
        1
      ],
      "vae": [
        "1",
        2
      ],
      "mask": [
        "90",
        2
      ],
      "grow_mask_by": 16
    }
  },
  "51": {
    "class_type": "INPAINT_ApplyFooocusInpaint",
    "_meta": {
      "title": "Apply Fooocus inpaint"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "patch": [
        "50",
        0
      ],
      "latent": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (inpaint)"
    },
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "51",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "5",
        0
      ]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "91": {
    "class_type": "InpaintStitchImproved",
    "_meta": {
      "title": "Stitch back"
    },
    "inputs": {
      "stitcher": [
        "90",
        0
      ],
      "inpainted_image": [
        "8",
        0
      ]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    },
    "inputs": {
      "filename_prefix": "tsumiki_hair_sdxl",
      "images": [
        "91",
        0
      ]
    }
  }
}
