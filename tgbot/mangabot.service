# Bare-metal alternative to docker-compose.yml (preferred deploy is Docker on
# the JODA NAS — see README.md). Adjust paths to the checkout location.
# Install:
#   sudo cp mangabot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mangabot
[Unit]
Description=Tsumiki Telegram bot backend
After=network-online.target
Wants=network-online.target

[Service]
User=ol1n
WorkingDirectory=/volume1/Code/MangaPrompts/tgbot
EnvironmentFile=/etc/mangabot/env
ExecStart=/volume1/Code/MangaPrompts/tgbot/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
