# Copy to restyler.env (gitignored) and fill in. Never commit real tokens.
# See docs/restyler-release.md.
AUTH_MODE=app
# 64 hex: openssl rand -hex 32
APP_TOKEN=
APP_NAME=Restyler
FREE_DAILY_LIMIT=40

# ComfyUI on SPARK — over the LAN:
COMFY_URL=http://192.168.1.xxx:8188
# …or through the public hostname (needs a CF Access service token):
# COMFY_URL=https://comfyui.ol1n.com
# COMFY_CF_ID=
# COMFY_CF_SECRET=

# video-api on SPARK (wan_motion steps) — over the LAN:
VIDEO_URL=http://192.168.1.xxx:8096/v1/video
# VIDEO_URL=https://llm.ol1n.com/v1/video
# VIDEO_CF_ID=
# VIDEO_CF_SECRET=

# Defaults, change only with a reason:
# RENDER_CONCURRENCY=2
# RENDER_VIDEO_COST=5
# LIVE_TIMEOUT=180
# RESTYLE_CKPT_PHOTO=
# RESTYLE_CKPT_ILLUSTRATION=
