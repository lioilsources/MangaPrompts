# Copy to mangabot.env (gitignored) and fill in. Never commit real tokens.
BOT_TOKEN=

# ComfyUI on SPARK — over the LAN:
COMFY_URL=http://192.168.1.xxx:8188
# …or through the public hostname (needs a CF Access service token):
# COMFY_URL=https://comfyui.ol1n.com
# COMFY_CF_ID=
# COMFY_CF_SECRET=

# video-api on SPARK (photo animations) — over the LAN:
VIDEO_URL=http://192.168.1.xxx:8096/v1/video
# …or through the public hostname (needs a CF Access service token):
# VIDEO_URL=https://llm.ol1n.com/v1/video
# VIDEO_CF_ID=
# VIDEO_CF_SECRET=

ALLOWED_ORIGINS=https://app.ol1n.com
MINIAPP_URL=https://app.ol1n.com

FREE_DAILY_LIMIT=3
VIDEO_FREE_DAILY_LIMIT=1
# Podlaha a strop deadline renderu (s); samotný deadline se počítá z odhadu,
# který vrátí video-api na submit. Defaulty 1800 / 14400.
# VIDEO_JOB_TIMEOUT=1800
# VIDEO_JOB_TIMEOUT_MAX=14400
# Telegram user id allowed to run /refund:
ADMIN_USER_ID=

# Dev instance only:
# DEV_TOKEN=

# Only when running the cloudflared sidecar from docker-compose:
# TUNNEL_TOKEN=
