# Copy to mangabot.env (gitignored) and fill in. Never commit real tokens.
BOT_TOKEN=

# ComfyUI on SPARK — over the LAN:
COMFY_URL=http://192.168.1.xxx:8188
# …or through the public hostname (needs a CF Access service token):
# COMFY_URL=https://comfyui.ol1n.com
# COMFY_CF_ID=
# COMFY_CF_SECRET=

ALLOWED_ORIGINS=https://app.ol1n.com
MINIAPP_URL=https://app.ol1n.com

FREE_DAILY_LIMIT=3
# Telegram user id allowed to run /refund:
ADMIN_USER_ID=

# Dev instance only:
# DEV_TOKEN=

# Only when running the cloudflared sidecar from docker-compose:
# TUNNEL_TOKEN=
